# 過去作品のアーカイブフォルダ：HTML/CSS/画像の閲覧のみ許可し、PHPは一切実行させない
# （古いWordPress一式や旧お問い合わせフォームが含まれているため）
<FilesMatch "\.(?:php[0-9]?|phtml|phar|pht|inc)$">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule \.(?:php[0-9]?|phtml|phar|pht|inc)$ - [F,NC]
</IfModule>
Options -Indexes
